# Copy this file to .env and adjust as needed.  NEVER commit the real .env.
# Every value below has a safe default in src/utils/config.py, so the project
# runs even if .env is absent.

# ---- MQTT (optional) ----
# Leave MQTT_BROKER empty to run without a broker; the dashboard falls back to
# SIMULATION MODE automatically.
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=energy/data
MQTT_KEEPALIVE=60

# ---- Device ----
DEVICE_ID=ENERGY_NODE_01
SIMULATOR_INTERVAL_SECONDS=2

# ---- Storage ----
DATABASE_PATH=data/energy.db
MODEL_PATH=models/best_model.pkl

# ---- Cost estimation ----
TARIFF_PER_KWH=8.0
CURRENCY_SYMBOL=Rs.

# ---- Logging ----
LOG_LEVEL=INFO
